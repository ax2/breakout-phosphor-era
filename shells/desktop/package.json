{
  "name": "breakout-phosphor-era",
  "productName": "BREAKOUT 磷光纪元",
  "version": "0.7.0",
  "description": "BREAKOUT：磷光纪元 — 桌面端外壳（与网页版共用同一份核心）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --dir",
    "pack": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^42.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zicode.breakout.phosphor",
    "productName": "BREAKOUT Phosphor Era",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "../../web", "to": "web" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BREAKOUT-PhosphorEra-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
